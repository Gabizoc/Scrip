# ── Clés API ────────────────────────────────────────────────────────────────

# Mistral (https://console.mistral.ai/) — obligatoire pour l'OCR
MISTRAL_API_KEY=your_mistral_api_key_here

# OpenRouter (https://openrouter.ai/keys) — obligatoire pour la structuration IA
OPENROUTER_API_KEY=your_openrouter_api_key_here

# NVIDIA NIM (https://build.nvidia.com/) — recommandé, gratuit avec quota généreux
NVIDIA_API_KEY=your_nvidia_api_key_here

# Google AI Studio (https://aistudio.google.com/apikey) — requis pour PIPELINE_MODE=google
GOOGLE_API_KEY=your_google_api_key_here

# Ollama — requis pour PIPELINE_MODE=ollama
# Base URL de ton instance Ollama (locale ou cloud)
OLLAMA_BASE_URL=http://localhost:11434
# Modèle à utiliser (doit être installé : ollama pull gemma4:31b-cloud)
OLLAMA_MODEL=gemma4:31b-cloud
# Clé API optionnelle si ton instance Ollama est protégée
# OLLAMA_API_KEY=

# ── Backend ──────────────────────────────────────────────────────────────────

# Port du serveur Express (défaut : 5001)
PORT=5001

# Mode pipeline IA :
#   vision  → LLM multimodal lit l'image directement via NVIDIA/OpenRouter (1 étape)
#   ocr     → pixtral OCR puis LLM texte (2 étapes, fallback)
#   google  → Gemini AI Studio lit l'image directement (1 étape, meilleur sur le français)
#   ollama  → modèle vision via Ollama (local ou cloud), configure OLLAMA_BASE_URL + OLLAMA_MODEL
PIPELINE_MODE=google

# Debug pipeline : sauvegarde les données brutes dans vault/_debug/<timestamp>.json
DEBUG_PIPELINE=false

# Chemin vers la base de données lowdb (défaut : backend/data/db.json)
# DB_PATH=./backend/data/db.json

# ── Auth (OBLIGATOIRES en production) ────────────────────────────────────────

# Email autorisé à se connecter et à recevoir les liens magic/reset
PUBLIC_URL=https://scrip.gabizoc.fr
AUTH_EMAIL=you@example.com

# Secret de session — générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-32-char-string

# ── SMTP (pour les magic links et reset de mot de passe) ─────────────────────

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
# Pour Gmail : utilise un "App Password" (pas ton mot de passe principal)
SMTP_PASS=your-app-password
SMTP_FROM=Scrip <you@gmail.com>

# ── CLI ingest.js ────────────────────────────────────────────────────────────

# Matière utilisée par le CLI (défaut : histoire)
# SCRIP_SUBJECT=histoire

# Niveau scolaire utilisé par le CLI (défaut : 1ère)
# SCRIP_LEVEL=1ère
