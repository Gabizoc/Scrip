# Scrip - Configuration

# ---- Cles API + Modeles ----

# Ollama - https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_VALIDATION=true

# Google AI Studio - https://aistudio.google.com/apikey (requis pour PIPELINE_MODE=google)
# GOOGLE_API_KEY=your_google_api_key_here
# Modele Gemini (defaut : cascade gemini-2.5-flash -> 2.0-flash -> 1.5-flash -> 1.5-flash-8b)
# GEMINI_MODEL=gemini-2.5-flash

# Mistral - https://console.mistral.ai (requis pour PIPELINE_MODE=ocr)
# MISTRAL_API_KEY=your_mistral_api_key_here
# MISTRAL_OCR_MODEL=pixtral-large-latest

# OpenRouter - https://openrouter.ai/keys (requis pour PIPELINE_MODE=vision)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_STRUCTURE_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_SUMMARY_MODEL=google/gemma-4-26b-a4b-it:free

# NVIDIA NIM - https://build.nvidia.com (requis pour PIPELINE_MODE=vision)
# NVIDIA_API_KEY=your_nvidia_api_key_here
# NVIDIA_VISION_MODEL=nvidia/llama-3.2-90b-vision-instruct
# NVIDIA_STRUCTURE_MODEL=mistralai/mistral-medium-3-instruct

# ---- Backend ----

PORT=7001

# auto    -> essaie dans l'ordre : ollama -> google -> nvidia -> mistral (recommande)
# ollama  -> Ollama cloud/local (necessite OLLAMA_BASE_URL + OLLAMA_MODEL)
# google  -> Gemini (necessite GOOGLE_API_KEY)
# nvidia  -> NVIDIA NIM uniquement (necessite NVIDIA_API_KEY)
# mistral -> Mistral OCR + LLM (necessite MISTRAL_API_KEY)
PIPELINE_MODE=auto

DEBUG_PIPELINE=false

# ---- Auth ----

PUBLIC_URL=https://your-domain.com
AUTH_EMAIL=you@example.com
SESSION_SECRET=change-to-a-random-32-char-string

# ---- SMTP ----

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Scrip <you@gmail.com>
