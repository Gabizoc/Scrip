# Scrip - Configuration

# ---- Cles API ----

# Google AI Studio - https://aistudio.google.com/apikey (requis pour PIPELINE_MODE=google)
GOOGLE_API_KEY=your_google_api_key_here

# Modes alternatifs (optionnels - conseille : google ou ollama)
# MISTRAL_API_KEY=your_mistral_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# NVIDIA_API_KEY=your_nvidia_api_key_here

# Ollama (validation croisee du pipeline Google)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_VALIDATION=true

# ---- Backend ----

PORT=7001
PIPELINE_MODE=google
DEBUG_PIPELINE=false

# ---- Auth ----

PUBLIC_URL=https://your-domain.com
AUTH_EMAIL=you@example.com
SESSION_SECRET=change-to-a-random-32-char-string

# ---- SMTP ----

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Scrip <you@gmail.com>
