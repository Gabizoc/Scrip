# Scrip - Configuration

# ---- Cles API + Modeles ----

# Ollama - https://ollama.com
# Option A : Ollama local (ou relay cloud via l'app Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud
# Option B : Ollama Cloud direct, sans installation - https://docs.ollama.com/cloud
# Cle a creer sur https://ollama.com/settings/keys. Si OLLAMA_BASE_URL est absent,
# la cle seule suffit (bascule sur https://ollama.com). Le suffixe -cloud est retire automatiquement.
# OLLAMA_API_KEY=your_ollama_api_key_here
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_MODEL=gemma4:31b
OLLAMA_VALIDATION=true

# Google AI Studio - https://aistudio.google.com/apikey (requis pour PIPELINE_MODE=google)
# GOOGLE_API_KEY=your_google_api_key_here
# Modele Gemini (defaut : cascade gemini-2.5-flash -> 2.0-flash -> 1.5-flash -> 1.5-flash-8b)
# GEMINI_MODEL=gemini-2.5-flash
# Tokens de raisonnement pour lire les photos (0 = desactive)
# GEMINI_THINKING_BUDGET=1024

# Mistral - https://console.mistral.ai (requis pour PIPELINE_MODE=mistral)
# MISTRAL_API_KEY=your_mistral_api_key_here
# MISTRAL_OCR_MODEL=pixtral-large-latest

# OpenRouter - https://openrouter.ai/keys (structuration en mode mistral, resume automatique)
# Sans cle OpenRouter, le resume automatique passe par Ollama s'il est configure.
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_STRUCTURE_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_SUMMARY_MODEL=google/gemma-4-26b-a4b-it:free

# NVIDIA NIM - https://build.nvidia.com (requis pour PIPELINE_MODE=nvidia)
# NVIDIA_API_KEY=your_nvidia_api_key_here
# NVIDIA_VISION_MODEL=nvidia/llama-3.2-90b-vision-instruct
# NVIDIA_STRUCTURE_MODEL=mistralai/mistral-medium-3-instruct

# ---- Preparation des photos ----
# Plus grand cote des images envoyees a l'IA (pixels)
# IMAGE_MAX_SIDE=1600
# false : envoie la page entiere au lieu de deux bandes haute/basse (moins de quota, lecture moins fine)
# IMAGE_TILING=true
# false : desactive le rehaussement du contraste
# IMAGE_ENHANCE=true

# ---- Backend ----

PORT=7001
# Port du serveur de dev Vite (npm run dev)
# FRONTEND_PORT=5000

# auto   -> essaie dans l'ordre : ollama -> google -> nvidia -> mistral (recommande)
# ollama  -> Ollama cloud/local (necessite OLLAMA_BASE_URL ou OLLAMA_API_KEY)
# google  -> Gemini (necessite GOOGLE_API_KEY)
# nvidia  -> NVIDIA NIM uniquement (necessite NVIDIA_API_KEY)
# mistral -> Mistral OCR + LLM (necessite MISTRAL_API_KEY)
PIPELINE_MODE=auto

DEBUG_PIPELINE=false

# Niveau de logs : fatal, error, warn, info (defaut) ou debug (traces detaillees du pipeline,
# contenu des notes inclus). DEBUG_PIPELINE=true active aussi le niveau debug.
# LOG_LEVEL=info

# Delai max d'un appel a un fournisseur IA, en millisecondes (defaut : 180000)
# LLM_TIMEOUT_MS=180000

# ---- Auth ----

PUBLIC_URL=https://your-domain.com
# 16 caracteres minimum. Generer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-to-a-random-32-char-string

# Mode authentification - choisir UN seul (pas les deux simultanement)

# Option 1 : mot de passe simple (recommande - aucun serveur mail requis)
AUTH_PASSWORD=change-to-a-strong-password

# Option 2 : magic link par email (necessite SMTP_* ci-dessous)
# AUTH_EMAIL=you@example.com

# ---- SMTP (requis uniquement si AUTH_EMAIL est active) ----

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Scrip <you@gmail.com>
