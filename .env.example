# ── Clés API ────────────────────────────────────────────────────────────────

# Mistral (https://console.mistral.ai/) — obligatoire pour l'OCR
MISTRAL_API_KEY=your_mistral_api_key_here

# OpenRouter (https://openrouter.ai/keys) — obligatoire pour la structuration IA
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Backend ──────────────────────────────────────────────────────────────────

# Port du serveur Express (défaut : 3001)
PORT=3001

# Chemin vers la base de données lowdb (défaut : backend/data/db.json)
# DB_PATH=./backend/data/db.json

# ── CLI ingest.js ────────────────────────────────────────────────────────────

# Matière utilisée par le CLI (défaut : histoire)
# SCRIP_SUBJECT=histoire

# Niveau scolaire utilisé par le CLI (défaut : 1ère)
# SCRIP_LEVEL=1ère
