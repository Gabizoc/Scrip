# nginx/scrip.conf.example
# 1. Copier : cp nginx/scrip.conf.example /etc/nginx/sites-available/scrip
# 2. Adapter les valeurs YOUR_* ci-dessous
# 3. Activer : ln -s /etc/nginx/sites-available/scrip /etc/nginx/sites-enabled/scrip
# 4. Recharger : nginx -t && systemctl reload nginx

server {
    listen 443 ssl http2;
    server_name YOUR_DOMAIN;  # ex: scrip.example.com

    ssl_certificate     /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;

    # ── Frontend React (Vite build) ───────────────────────────────────────────
    root YOUR_APP_PATH/frontend/dist;  # ex: /var/www/scrip/frontend/dist

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Service worker : jamais en cache, sinon les mises à jour de l'app ne sont pas vues
    location = /sw.js {
        add_header Cache-Control "no-cache";
    }

    # Cache long sur les assets hashés par Vite (main-a1b2c3.js, etc.)
    location ~* \.(js|css|png|jpg|jpeg|webp|woff2|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # ── Backend API ───────────────────────────────────────────────────────────
    # ^~ empêche les regex (ex: *.jpg) d'intercepter les URLs /api/
    location ^~ /api/ {
        proxy_pass         http://localhost:7001/api/;  # PORT = valeur de PORT dans ecosystem.config.js
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # Timeout long pour le pipeline IA et le flux de progression (SSE)
        proxy_read_timeout 300s;
        proxy_buffering    off;

        # Jusqu'à 10 photos de 20 Mo par ingestion
        client_max_body_size 210m;
    }

    # ── WebDAV (sync Obsidian) ────────────────────────────────────────────────
    location ^~ /webdav/ {
        proxy_pass         http://localhost:7001/webdav/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # Toutes les méthodes WebDAV (PROPFIND, MKCOL, COPY, MOVE…)
        proxy_pass_request_headers on;

        client_max_body_size 50m;
    }
}

# ── Redirection HTTP → HTTPS ──────────────────────────────────────────────────
# Le renouvellement Certbot (plugin nginx) passe aussi par ce bloc.
server {
    listen 80;
    server_name YOUR_DOMAIN;
    return 301 https://$host$request_uri;
}
